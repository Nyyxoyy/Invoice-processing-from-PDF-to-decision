{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/AISearchBar/**",
              "components/Badge/**",
              "components/Button/**",
              "components/ConnectionCard/**",
              "components/DataTable/**",
              "components/ModeMenu/**",
              "components/Sidebar/**",
              "components/Toast/**",
              "components/TopNav/**",
              "preview/**",
              "ui_kits/bicycle-app/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Outfit|JetBrains Mono))/i]",
        "message": "Font not provided by the design system. Available: Outfit, JetBrains Mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='AISearchBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|onChange|mode|onModeChange|onSubmit|placeholder|key|ref|className|style|children)$/]",
        "message": "<AISearchBar> doesn't accept that prop. Declared props: value, onChange, mode, onModeChange, onSubmit, placeholder."
      },
      {
        "selector": "JSXOpeningElement[name.name='AISearchBar'] > JSXAttribute[name.name='mode'] > Literal[value!=/^(?:fast|balanced|deep)$/]",
        "message": "<AISearchBar> mode must be one of 'fast' | 'balanced' | 'deep'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|dot|children|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: tone, dot, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:success|warning|danger|info|accent|neutral)$/]",
        "message": "<Badge> tone must be one of 'success' | 'warning' | 'danger' | 'info' | 'accent' | 'neutral'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|icon|iconRight|disabled|children|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, icon, iconRight, disabled, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|text|danger)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'text' | 'danger'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md)$/]",
        "message": "<Button> size must be one of 'sm' | 'md'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ConnectionCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|type|status|rows|icon|syncedLabel|key|ref|className|style|children)$/]",
        "message": "<ConnectionCard> doesn't accept that prop. Declared props: name, type, status, rows, icon, syncedLabel."
      },
      {
        "selector": "JSXOpeningElement[name.name='ConnectionCard'] > JSXAttribute[name.name='status'] > Literal[value!=/^(?:connected|stale|failed)$/]",
        "message": "<ConnectionCard> status must be one of 'connected' | 'stale' | 'failed'."
      },
      {
        "selector": "JSXOpeningElement[name.name='DataTableColumn'] > JSXAttribute > JSXIdentifier[name!=/^(?:key|label|align|kind|render|key|ref|className|style|children)$/]",
        "message": "<DataTableColumn> doesn't accept that prop. Declared props: key, label, align, kind, render."
      },
      {
        "selector": "JSXOpeningElement[name.name='DataTableColumn'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:left|right|center)$/]",
        "message": "<DataTableColumn> align must be one of 'left' | 'right' | 'center'."
      },
      {
        "selector": "JSXOpeningElement[name.name='DataTableColumn'] > JSXAttribute[name.name='kind'] > Literal[value!=/^(?:delta|currency|muted)$/]",
        "message": "<DataTableColumn> kind must be one of 'delta' | 'currency' | 'muted'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Mode'] > JSXAttribute > JSXIdentifier[name!=/^(?:id|icon|label|sub|key|ref|className|style|children)$/]",
        "message": "<Mode> doesn't accept that prop. Declared props: id, icon, label, sub."
      },
      {
        "selector": "JSXOpeningElement[name.name='Mode'] > JSXAttribute[name.name='id'] > Literal[value!=/^(?:fast|balanced|deep)$/]",
        "message": "<Mode> id must be one of 'fast' | 'balanced' | 'deep'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SidebarItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:id|icon|label|key|ref|className|style|children)$/]",
        "message": "<SidebarItem> doesn't accept that prop. Declared props: id, icon, label."
      },
      {
        "selector": "JSXOpeningElement[name.name='Toast'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|title|sub|onClose|key|ref|className|style|children)$/]",
        "message": "<Toast> doesn't accept that prop. Declared props: tone, title, sub, onClose."
      },
      {
        "selector": "JSXOpeningElement[name.name='Toast'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:success|warning|danger|info)$/]",
        "message": "<Toast> tone must be one of 'success' | 'warning' | 'danger' | 'info'."
      },
      {
        "selector": "JSXOpeningElement[name.name='TopNav'] > JSXAttribute > JSXIdentifier[name!=/^(?:agentName|label|persona|personaCompact|workspace|onAssistant|key|ref|className|style|children)$/]",
        "message": "<TopNav> doesn't accept that prop. Declared props: agentName, label, persona, personaCompact, workspace, onAssistant."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
