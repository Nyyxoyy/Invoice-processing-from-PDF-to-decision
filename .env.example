GEMINI_API_KEY=paste-your-key-here
# Roles have no passwords: the demo is open and roles are switched from the top bar.
# Intake connectors (see backend/app/connectors.py and sources.py)
# INTAKE_DIR=/data/intake            # watched folder (default <DATA_DIR>/intake); INTAKE_POLL_SECONDS=10
# INTAKE_IMAP_HOST=imap.gmail.com    # AP mailbox; use an app password
# INTAKE_IMAP_USER=ap-invoices@example.com
# INTAKE_IMAP_PASSWORD=
# INTAKE_IMAP_FOLDER=INBOX
# Google Drive / Cloud Storage via a deployment service account
# GOOGLE_APPLICATION_CREDENTIALS=/secrets/sa.json
# GCS_BUCKET=ap-invoice-intake
# GCS_PREFIX=incoming/
# GDRIVE_FOLDER_ID=
